# Environment Variables for Course Automation Scripts
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials to version control!

# Canvas Configuration
CANVAS_API_TOKEN=your-canvas-api-token-here
CANVAS_INSTANCE_URL=https://yourschool.instructure.com

# GitHub Configuration
GITHUB_TOKEN=your-github-personal-access-token-here

# Slack Configuration (optional)
SLACK_TOKEN=xoxb-your-slack-bot-token-here

# Notes:
# - Canvas token: Account → Settings → Approved Integrations → New Access Token
# - GitHub token: Settings → Developer settings → Personal access tokens → Generate new token
#   Required scopes: repo, project
# - Slack token: Create app at https://api.slack.com/apps
#   Required scopes: channels:manage, channels:write, groups:write, users:read, users:read.email
